{
  "name": "حافظ — Hafiz",
  "short_name": "حافظ",
  "description": "ملاحظات وروابط وكلمات سر وصور — متزامنة بين الكمبيوتر والموبايل ومشفرة بالكامل.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "dir": "rtl",
  "lang": "ar",
  "background_color": "#f4f5f9",
  "theme_color": "#5046e5",
  "categories": ["productivity", "utilities", "security"],
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "ملاحظة جديدة", "short_name": "ملاحظة", "url": "./?new=note", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "رابط جديد", "short_name": "رابط", "url": "./?new=link", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "كلمة سر جديدة", "short_name": "كلمة سر", "url": "./?new=password", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "images", "accept": ["image/*"] }]
    }
  }
}
